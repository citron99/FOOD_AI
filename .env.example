# SmartKitchen Family — пример переменных окружения для интеграций
# Скопируйте в .env, заполните значения и НЕ коммитьте .env в репозиторий.
# Адаптеры читают эти переменные через os.environ; секреты — только отсюда,
# никогда не передавайте их через CLI-флаги.
#
# Запуск с внешним источником:
#   python -m agent.cli --source iiko --as-of 2026-08-18

# ---------- R:keeper (UCS), XML-интерфейс RK7 API ----------
# URL сервера R:keeper в локальной сети заведения.
RK7_BASE_URL=http://192.168.0.10:8080
# Имя интерфейса (станции) и учётная запись, созданные в менеджерской RK7
# с правом чтения справочников (Service → Интерфейсы).
RK7_STATION=RK7
RK7_USER=sk_agent
RK7_PASSWORD=

# ---------- iiko, iikoCloud API ----------
# Базовый URL облака iiko (для РФ — как ниже; для других регионов — другой хост).
IIKO_BASE_URL=https://api-ru.iiko.services
# Долгоживущий API-ключ: бэк-офис iiko → Настройки → Интеграции → API keys.
# Ключ привязывается к организациям — выдайте доступ только на чтение номенклатуры.
IIKO_API_TOKEN=

# ---------- QuickResto, REST API ----------
# URL вашего аккаунта QuickResto (см. в адресной строке личного кабинета).
QR_BASE_URL=https://demo.quickresto.ru
# Учётная запись с доступом к API (Настройки → Пользователи → разрешить API).
QR_USER=
QR_PASSWORD=

# ---------- FrontPad, API со secret-ключом ----------
# URL вашего аккаунта FrontPad.
FRONTPAD_BASE_URL=https://demo.frontpad.ru
# Секретный ключ: личный кабинет FrontPad → Настройки → API.
FRONTPAD_SECRET=

# ---------- DeepSeek API (LLM-подсказки блюд, флаг --suggest-menu) ----------
# Ключ из кабинета DeepSeek (platform.deepseek.com → API keys).
# LLM-подсказки не применяются автоматически — требуют ручного подтверждения.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------- Saby (СБИС) Presto ----------
# Точный endpoint и поля — сверить с документацией Saby для вашего тарифа
# (заготовка по умолчанию ниже может не совпасть с вашей конфигурацией).
SABY_BASE_URL=
SABY_API_TOKEN=
# SABY_ENDPOINT=/api/v1/products
# SABY_NAME_FIELD=name
# SABY_UNIT_FIELD=unit

# ---------- YUMA ----------
# Точный endpoint и поля — сверить с документацией YUMA.
YUMA_BASE_URL=
YUMA_API_TOKEN=
# YUMA_ENDPOINT=/api/v1/products
# YUMA_NAME_FIELD=name
# YUMA_UNIT_FIELD=unit
