# SmartKitchen Family — секреты и параметры интеграций для контейнера.
#
# Рабочая копия: /opt/food_ai/food_ai.env, права ОБЯЗАТЕЛЬНО 600 (владелец root).
# Файл передаётся контейнеру через `docker run --env-file`, поэтому формат —
# `KEY=value` без `export`, без кавычек вокруг значения и без пробелов у «=».
#
# Полный список переменных всех POS-источников — в .env.example в корне репозитория.
# Пустые значения безопасны: адаптер сообщит об ошибке конфигурации, а не упадёт молча.

# ---------- DeepSeek (нужен только при SUGGEST_MENU="true") ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# ---------- iiko (при EXTRA_ARGS="--source iiko") ----------
IIKO_BASE_URL=https://api-ru.iiko.services
IIKO_API_TOKEN=

# ---------- R:keeper RK7 (при EXTRA_ARGS="--source rkeeper") ----------
# RK7 живёт в локальной сети заведения: с VPS он недоступен, нужен VPN-туннель
# от площадки до сервера (см. docs/deploy_beget.md, маршрут C).
RK7_BASE_URL=
RK7_STATION=RK7
RK7_USER=
RK7_PASSWORD=

# ---------- QuickResto ----------
QR_BASE_URL=
QR_USER=
QR_PASSWORD=

# ---------- FrontPad ----------
FRONTPAD_BASE_URL=
FRONTPAD_SECRET=
