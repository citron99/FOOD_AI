# SmartKitchen Family — необязательная публикация отчёта на внешний хостинг.
#
# Рабочая копия: /opt/food_ai/publish.env, права 600. Если файла нет —
# run-report.sh просто пропустит шаг публикации.
#
# Нужен только в гибридной схеме: отчёт считается на VPS, а дополнительно
# выкладывается на обычный shared-хостинг (маршруты A/B из docs/deploy_beget.md).
# Для VPS + nginx публикация не требуется — nginx отдаёт каталог reports напрямую.
#
# Загрузка выполняется через curl --upload-file, поэтому PUBLISH_URL может быть
# ftp://, ftps:// или sftp:// (для sftp нужен openssh-client на хосте).
# Логин и пароль указываются в URL или через ~/.netrc (chmod 600) — в репозиторий
# этот файл не коммитится.

PUBLISH_ENABLED="false"
# Пример: PUBLISH_URL="ftp://LOGIN:PASSWORD@ftp.example.com/htdocs/reports"
PUBLISH_URL=""
